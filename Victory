function calcBOMCost(pump){
  return pump.materials.reduce((sum,bm)=>{
    const mat=materials.find(m=>m.id===bm.matId);
    return sum+(mat?mat.price*bm.qty:0);
  },0);
}

function renderBOM(){
  if(currentUser.role!=='admin'&&currentUser.role!=='x') return;
  document.getElementById('bomCards').innerHTML=pumps.map(pump=>{
    const cost=calcBOMCost(pump);
    const margin=pump.sellPrice>0?((pump.sellPrice-cost)/pump.sellPrice*100).toFixed(1):0;
    return `<div class="bom-card">
      <div class="bom-head">
        <div class="bom-pump-name">${pump.icon} ${pump.name}</div>
        <div class="bom-meta">
          <span class="bom-cost-label">Cost:</span><span class="bom-val bom-val-cost"> ₹${cost.toLocaleString()}</span>
          <span style="color:var(--border)"> | </span>
          <span class="bom-cost-label">Sell:</span><span class="bom-val bom-val-margin"> ₹${pump.sellPrice.toLocaleString()} · ${margin}% margin</span>
        </div>
        <div style="display:flex;gap:8px;margin-top:8px;">
          <button class="btn-sm btn-edit" onclick="editPump('${pump.id}')">✏ Edit BOM</button>
          <button class="btn-sm btn-del" onclick="deletePump('${pump.id}')">Delete</button>
        </div>
      </div>
      ${pump.materials.map(bm=>{
        const mat=materials.find(m=>m.id===bm.matId);
        if(!mat) return '';
        return `<div class="bom-row"><span class="bom-part">${mat.name} × ${bm.qty}</span><span class="bom-part-cost">₹${(mat.price*bm.qty).toLocaleString()}</span></div>`;
      }).join('')}
      <div class="bom-footer"><span class="bom-footer-label">Selling Price</span><span class="bom-footer-val">₹${pump.sellPrice.toLocaleString()}</span></div>
    </div>`;
  }).join('');
}

