<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>FISO Pumps</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#080e1a;--surface:#0f1724;--surface2:#162035;--border:#1c2d47;
  --accent:#00d4ff;--blue:#0066ff;--warn:#ffaa00;--danger:#ff4444;
  --success:#00e676;--text:#e2eeff;--muted:#5a7299;
  --font:'Syne',sans-serif;--mono:'DM Mono',monospace;
  --radius:14px;--btn-h:56px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:var(--font);max-width:480px;margin:0 auto;position:relative;}

/* SCROLLABLE CONTENT */
.app-shell{display:flex;flex-direction:column;height:100vh;}
.content{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;padding:16px 14px 100px;}
.content::-webkit-scrollbar{display:none;}

/* LOGIN */
#loginScreen{position:fixed;inset:0;background:var(--bg);z-index:1000;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;max-width:480px;margin:0 auto;}
.login-logo{font-size:38px;font-weight:800;margin-bottom:4px;text-align:center;}
.login-logo span{color:var(--accent);}
.login-tagline{font-size:11px;font-family:var(--mono);color:var(--muted);letter-spacing:2px;margin-bottom:32px;text-transform:uppercase;}
.login-box{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:24px;}
.login-title{font-size:20px;font-weight:800;margin-bottom:16px;}
.login-field{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px;color:var(--text);font-family:var(--font);font-size:16px;margin-bottom:12px;outline:none;-webkit-appearance:none;}
.login-field:focus{border-color:var(--blue);}
.login-btn{width:100%;height:var(--btn-h);background:linear-gradient(135deg,var(--blue),var(--accent));border:none;border-radius:12px;color:#fff;font-weight:800;font-size:17px;font-family:var(--font);cursor:pointer;margin-top:4px;}
.login-err{color:var(--danger);font-size:13px;font-family:var(--mono);margin-top:10px;text-align:center;}

/* TOPBAR */
.topbar{background:rgba(8,14,26,0.98);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.logo-main{font-size:20px;font-weight:800;}
.logo-main span{color:var(--accent);}
.logo-sub{font-size:9px;font-family:var(--mono);color:var(--muted);letter-spacing:1px;text-transform:uppercase;}
.role-chip{font-size:10px;font-family:var(--mono);border-radius:20px;padding:4px 12px;}
.rc-staff{color:var(--accent);background:rgba(0,212,255,0.1);border:1px solid rgba(0,212,255,0.2);}
.rc-manager{color:var(--warn);background:rgba(255,170,0,0.1);border:1px solid rgba(255,170,0,0.2);}
.rc-admin{color:#ff6b6b;background:rgba(255,68,68,0.1);border:1px solid rgba(255,68,68,0.2);}
.rc-x{color:#c678ff;background:rgba(198,120,255,0.1);border:1px solid rgba(198,120,255,0.2);}
.logout-btn{font-size:10px;font-family:var(--mono);color:var(--muted);cursor:pointer;margin-top:3px;letter-spacing:1px;}

/* BOTTOM NAV */
.bottom-nav{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;background:rgba(8,14,26,0.98);border-top:1px solid var(--border);display:flex;padding:8px 0 env(safe-area-inset-bottom,12px);z-index:50;}
.bnav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:9px;font-family:var(--mono);color:var(--muted);cursor:pointer;text-transform:uppercase;letter-spacing:0.3px;padding:4px 0;transition:color 0.2s;-webkit-tap-highlight-color:transparent;}
.bnav-item.active{color:var(--accent);}
.bnav-icon{font-size:22px;line-height:1;}

/* PAGES */
.page{display:none;}
.page.active{display:block;animation:fadeUp 0.25s ease;}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

/* SECTION HEADERS */
.page-tag{font-size:10px;font-family:var(--mono);color:var(--accent);text-transform:uppercase;letter-spacing:2px;margin-bottom:3px;}
.page-title{font-size:22px;font-weight:800;letter-spacing:-0.5px;margin-bottom:2px;}
.page-sub{font-size:11px;color:var(--muted);font-family:var(--mono);margin-bottom:16px;}

/* STAFF SIMPLE UI */
.big-btn{width:100%;height:72px;border:none;border-radius:16px;font-size:20px;font-weight:800;font-family:var(--font);cursor:pointer;margin-bottom:12px;display:flex;align-items:center;justify-content:center;gap:10px;-webkit-tap-highlight-color:transparent;}
.big-btn-green{background:linear-gradient(135deg,#00a854,var(--success));color:#060c18;}
.big-btn-red{background:linear-gradient(135deg,#cc0000,var(--danger));color:#fff;}
.big-btn-blue{background:linear-gradient(135deg,var(--blue),var(--accent));color:#fff;}

/* CARDS */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:12px;}
.card-head{padding:14px 16px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.card-title{font-size:14px;font-weight:700;}
.card-body{padding:14px 16px;}
.card-row{display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(28,45,71,0.5);font-size:13px;}
.card-row:last-child{border-bottom:none;}

/* STAT GRID */
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px;position:relative;overflow:hidden;}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.sc-blue::before{background:linear-gradient(90deg,var(--blue),var(--accent));}
.sc-green::before{background:var(--success);}
.sc-warn::before{background:var(--warn);}
.sc-red::before{background:var(--danger);}
.stat-label{font-size:10px;color:var(--muted);font-family:var(--mono);text-transform:uppercase;letter-spacing:1px;margin-bottom:5px;}
.stat-val{font-size:28px;font-weight:800;line-height:1;}
.sv-blue{color:var(--accent);}
.sv-green{color:var(--success);}
.sv-warn{color:var(--warn);}
.sv-red{color:var(--danger);}
.stat-hint{font-size:10px;color:var(--muted);font-family:var(--mono);margin-top:4px;}

/* ALERTS */
.alert{border-radius:12px;padding:12px 14px;display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;font-size:13px;line-height:1.5;}
.alert-red{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.2);}
.alert-warn{background:rgba(255,170,0,0.08);border:1px solid rgba(255,170,0,0.2);}
.alert-green{background:rgba(0,230,118,0.08);border:1px solid rgba(0,230,118,0.2);}
.alert-red strong{color:var(--danger);}
.alert-warn strong{color:var(--warn);}
.alert-green strong{color:var(--success);}

/* BADGES */
.badge{display:inline-flex;padding:3px 9px;border-radius:20px;font-size:10px;font-weight:600;font-family:var(--mono);}
.b-ok{background:rgba(0,230,118,0.1);color:var(--success);}
.b-low{background:rgba(255,170,0,0.1);color:var(--warn);}
.b-crit{background:rgba(255,68,68,0.1);color:var(--danger);}
.b-blue{background:rgba(0,102,255,0.1);color:var(--accent);}
.b-purple{background:rgba(198,120,255,0.1);color:#c678ff;}

/* INPUTS */
.field{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px;color:var(--text);font-family:var(--font);font-size:16px;margin-bottom:10px;outline:none;-webkit-appearance:none;appearance:none;}
.field:focus{border-color:var(--blue);}
.field-label{font-size:11px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;}
.field-row{display:flex;gap:8px;}
.field-row .field{flex:1;margin-bottom:0;}

/* BUTTONS */
.btn-confirm{width:100%;height:var(--btn-h);background:linear-gradient(135deg,var(--blue),var(--accent));border:none;border-radius:12px;color:#fff;font-weight:800;font-size:16px;font-family:var(--font);cursor:pointer;margin-top:8px;}
.btn-danger{width:100%;height:var(--btn-h);background:rgba(255,68,68,0.15);border:1px solid rgba(255,68,68,0.3);border-radius:12px;color:var(--danger);font-weight:800;font-size:16px;font-family:var(--font);cursor:pointer;margin-top:8px;}
.btn-sm{padding:6px 12px;border-radius:8px;font-size:11px;font-family:var(--mono);cursor:pointer;border:none;font-weight:600;-webkit-tap-highlight-color:transparent;}
.btn-edit{background:rgba(0,102,255,0.15);color:var(--accent);}
.btn-del{background:rgba(255,68,68,0.12);color:var(--danger);}
.btn-add{background:rgba(0,230,118,0.12);color:var(--success);}
.btn-warn{background:rgba(255,170,0,0.12);color:var(--warn);}

/* STOCK BAR */
.stock-bar{height:5px;background:var(--border);border-radius:4px;overflow:hidden;margin:5px 0;}
.stock-fill{height:100%;border-radius:4px;}
.sf-ok{background:var(--success);}
.sf-low{background:var(--warn);}
.sf-crit{background:var(--danger);}

/* CATEGORY ACCORDION */
.cat-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);margin-bottom:10px;overflow:hidden;}
.cat-header{padding:16px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;-webkit-tap-highlight-color:transparent;}
.cat-name{font-size:15px;font-weight:700;}
.cat-count{font-size:11px;font-family:var(--mono);color:var(--muted);}
.cat-arrow{color:var(--muted);transition:transform 0.2s;font-size:12px;}
.cat-arrow.open{transform:rotate(180deg);}
.cat-body{display:none;border-top:1px solid var(--border);}
.cat-body.open{display:block;}
.part-row{padding:14px 16px;border-bottom:1px solid rgba(28,45,71,0.4);display:flex;align-items:center;justify-content:space-between;}
.part-row:last-child{border-bottom:none;}
.part-name{font-size:14px;font-weight:600;margin-bottom:2px;}
.part-meta{font-size:11px;color:var(--muted);font-family:var(--mono);}
.part-right{text-align:right;flex-shrink:0;margin-left:8px;}
.part-stock-num{font-size:16px;font-weight:800;margin-bottom:2px;}
.part-actions{display:flex;gap:6px;margin-top:6px;justify-content:flex-end;flex-wrap:wrap;}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:200;display:flex;align-items:flex-end;justify-content:center;max-width:480px;margin:0 auto;}
.modal-overlay.hidden{display:none;}
.modal{background:var(--surface);border-radius:20px 20px 0 0;padding:24px;width:100%;max-height:85vh;overflow-y:auto;padding-bottom:calc(24px + env(safe-area-inset-bottom,0px));}
.modal::-webkit-scrollbar{display:none;}
.modal-title{font-size:18px;font-weight:800;margin-bottom:3px;}
.modal-sub{font-size:11px;color:var(--muted);font-family:var(--mono);margin-bottom:18px;}
.modal-actions{display:flex;gap:10px;margin-top:10px;}
.modal-confirm{flex:1;height:var(--btn-h);background:linear-gradient(135deg,var(--blue),var(--accent));border:none;border-radius:12px;color:#fff;font-weight:800;font-size:15px;font-family:var(--font);cursor:pointer;}
.modal-cancel{height:var(--btn-h);padding:0 20px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;color:var(--muted);font-weight:700;font-size:15px;font-family:var(--font);cursor:pointer;}
.modal-danger-btn{flex:1;height:var(--btn-h);background:rgba(255,68,68,0.15);border:1px solid rgba(255,68,68,0.3);border-radius:12px;color:var(--danger);font-weight:800;font-size:15px;font-family:var(--font);cursor:pointer;}

/* USED IN */
.used-in-row{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:var(--surface2);border-radius:10px;margin-bottom:6px;font-size:13px;}
.used-in-pump{font-weight:600;}
.used-in-qty{font-family:var(--mono);color:var(--accent);}

/* ACTIVITY */
.act-row{display:flex;align-items:flex-start;justify-content:space-between;padding:12px 16px;border-bottom:1px solid rgba(28,45,71,0.4);}
.act-row:last-child{border-bottom:none;}
.act-name{font-size:13px;font-weight:600;margin-bottom:2px;}
.act-meta{font-size:11px;color:var(--muted);font-family:var(--mono);}
.act-qty{font-size:14px;font-family:var(--mono);font-weight:700;flex-shrink:0;margin-left:8px;}
.act-plus{color:var(--success);}
.act-minus{color:var(--danger);}

/* BOM CARDS */
.bom-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:12px;}
.bom-head{padding:14px 16px;background:var(--surface2);border-bottom:1px solid var(--border);}
.bom-pump-name{font-size:15px;font-weight:700;margin-bottom:6px;}
.bom-meta{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px;}
.bom-cost-label{font-size:11px;font-family:var(--mono);color:var(--muted);}
.bom-val{font-size:11px;font-family:var(--mono);}
.bom-val-cost{color:var(--accent);}
.bom-val-margin{color:var(--success);}
.bom-row{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid rgba(28,45,71,0.3);font-size:13px;}
.bom-row:last-child{border-bottom:none;}
.bom-part{color:#a0b4d0;}
.bom-part-cost{font-family:var(--mono);color:var(--muted);}
.bom-footer{padding:12px 16px;background:rgba(0,230,118,0.03);border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
.bom-footer-label{font-size:11px;color:var(--muted);font-family:var(--mono);}
.bom-footer-val{font-size:16px;font-weight:800;color:var(--success);}
.bom-mat-row{display:flex;gap:8px;margin-bottom:8px;align-items:center;}
.bom-mat-row .field{margin-bottom:0;}
.remove-mat-btn{background:rgba(255,68,68,0.15);border:none;border-radius:8px;color:var(--danger);font-size:18px;padding:10px 14px;cursor:pointer;flex-shrink:0;}
.add-mat-line{background:rgba(0,230,118,0.07);border:1px dashed rgba(0,230,118,0.3);border-radius:10px;color:var(--success);font-family:var(--mono);font-size:12px;padding:12px;width:100%;cursor:pointer;margin-bottom:10px;text-align:center;}

/* CAPACITY */
.cap-result{background:var(--surface2);border-radius:12px;padding:16px;margin-bottom:10px;}
.cap-pump-name{font-size:16px;font-weight:800;margin-bottom:4px;}
.cap-can-make{font-size:36px;font-weight:800;color:var(--success);line-height:1;}
.cap-units{font-size:13px;color:var(--muted);font-family:var(--mono);margin-bottom:12px;}
.cap-bottleneck{background:rgba(255,68,68,0.08);border:1px solid rgba(255,68,68,0.2);border-radius:10px;padding:10px 14px;font-size:12px;margin-bottom:10px;}
.cap-mat-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(28,45,71,0.4);font-size:12px;}
.cap-mat-row:last-child{border-bottom:none;}

/* PAYMENTS */
.pay-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:10px;}
.pay-name{font-size:15px;font-weight:700;margin-bottom:3px;}
.pay-detail{font-size:11px;color:var(--muted);font-family:var(--mono);margin-bottom:10px;}
.pay-amount{font-size:24px;font-weight:800;margin-bottom:4px;}
.pay-overdue{font-size:11px;font-family:var(--mono);}
.pay-row{display:flex;justify-content:space-between;align-items:center;margin-top:10px;}
.pay-summary{background:var(--surface2);border-radius:12px;padding:16px;margin-bottom:14px;display:flex;justify-content:space-between;}
.pay-sum-item{text-align:center;}
.pay-sum-label{font-size:10px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;margin-bottom:4px;}
.pay-sum-val{font-size:18px;font-weight:800;}

/* CHATBOT */
.chat-messages{background:var(--surface2);border-radius:var(--radius);padding:14px;margin-bottom:12px;min-height:200px;max-height:350px;overflow-y:auto;}
.chat-messages::-webkit-scrollbar{display:none;}
.chat-bubble{margin-bottom:12px;max-width:85%;}
.chat-bubble.user{margin-left:auto;}
.chat-bubble.bot{margin-right:auto;}
.bubble-text{padding:12px 14px;border-radius:14px;font-size:13px;line-height:1.5;}
.chat-bubble.user .bubble-text{background:var(--blue);color:#fff;border-radius:14px 14px 4px 14px;}
.chat-bubble.bot .bubble-text{background:var(--surface);border:1px solid var(--border);border-radius:14px 14px 14px 4px;}
.bubble-meta{font-size:10px;font-family:var(--mono);color:var(--muted);margin-top:3px;padding:0 4px;}
.chat-input-row{display:flex;gap:8px;}
.chat-input{flex:1;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:14px;color:var(--text);font-family:var(--font);font-size:15px;outline:none;}
.chat-input:focus{border-color:var(--blue);}
.chat-send{background:var(--blue);border:none;border-radius:12px;padding:14px 18px;color:#fff;font-size:18px;cursor:pointer;flex-shrink:0;}

/* GOD MODE */
.god-section{background:rgba(198,120,255,0.05);border:1px solid rgba(198,120,255,0.2);border-radius:var(--radius);padding:16px;margin-bottom:12px;}
.god-section-title{font-size:13px;font-weight:700;color:#c678ff;margin-bottom:12px;font-family:var(--mono);text-transform:uppercase;letter-spacing:1px;}
.god-toggle-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(198,120,255,0.1);}
.god-toggle-row:last-child{border-bottom:none;}
.god-toggle-label{font-size:13px;}
.toggle{width:44px;height:24px;background:var(--border);border-radius:12px;cursor:pointer;position:relative;transition:background 0.2s;flex-shrink:0;}
.toggle.on{background:var(--blue);}
.toggle::after{content:'';position:absolute;width:18px;height:18px;background:#fff;border-radius:50%;top:3px;left:3px;transition:left 0.2s;}
.toggle.on::after{left:23px;}
.user-manage-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid rgba(198,120,255,0.1);}
.user-manage-row:last-child{border-bottom:none;}
.user-name-display{font-size:14px;font-weight:600;margin-bottom:2px;}
.user-role-display{font-size:11px;font-family:var(--mono);color:var(--muted);}

/* LOCK NOTICE */
.lock-notice{background:rgba(255,68,68,0.06);border:1px solid rgba(255,68,68,0.15);border-radius:10px;padding:10px 14px;font-size:11px;color:var(--danger);font-family:var(--mono);display:flex;align-items:center;gap:8px;margin-bottom:14px;}

/* PROFILE */
.profile-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:12px;text-align:center;}
.profile-avatar{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--accent));display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;margin:0 auto 12px;}
.profile-username{font-size:18px;font-weight:800;margin-bottom:4px;}
.profile-role{font-size:12px;font-family:var(--mono);color:var(--muted);}

/* TOAST */
.toast{position:fixed;bottom:85px;left:50%;transform:translateX(-50%);background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:12px 20px;font-size:13px;font-family:var(--mono);z-index:500;opacity:0;transition:opacity 0.3s;pointer-events:none;white-space:nowrap;max-width:90vw;}
.toast.show{opacity:1;}
.toast.t-ok{border-color:rgba(0,230,118,0.4);color:var(--success);}
.toast.t-err{border-color:rgba(255,68,68,0.4);color:var(--danger);}
.toast.t-warn{border-color:rgba(255,170,0,0.4);color:var(--warn);}

/* SECTION DIVIDER */
.sec-label{font-size:11px;font-weight:700;color:var(--muted);margin:14px 0 8px;font-family:var(--mono);text-transform:uppercase;letter-spacing:1px;}

/* SUPPLIER CARD */
.supplier-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:10px;}
.sup-name{font-size:15px;font-weight:700;margin-bottom:3px;}
.sup-loc{font-size:11px;color:var(--muted);font-family:var(--mono);margin-bottom:10px;}
.sup-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}
.sup-stat{background:var(--surface2);border-radius:8px;padding:10px;}
.sup-stat-label{font-size:9px;color:var(--muted);font-family:var(--mono);text-transform:uppercase;letter-spacing:1px;margin-bottom:2px;}
.sup-stat-val{font-size:13px;font-weight:700;}

/* GREET */
.greet-card{background:linear-gradient(135deg,rgba(0,102,255,0.12),rgba(0,212,255,0.06));border:1px solid rgba(0,212,255,0.12);border-radius:var(--radius);padding:16px;margin-bottom:14px;}
.greet-name{font-size:17px;font-weight:800;margin-bottom:2px;}
.greet-sub{font-size:11px;color:var(--muted);font-family:var(--mono);}

