function filterMvParts(){
  const q=document.getElementById('mvSearch').value.toLowerCase();
  const res=document.getElementById('mvPartResults');
  if(!q){res.style.display='none';return;}
  const matches=materials.filter(m=>m.name.toLowerCase().includes(q)||(m.brands&&m.brands.some(b=>b.toLowerCase().includes(q)))).slice(0,6);
  if(!matches.length){res.style.display='none';return;}
  res.style.display='block';
  res.innerHTML=matches.map(m=>`
    <div onclick="selectMvPart('${m.id}')" style="padding:12px 16px;border-bottom:1px solid rgba(28,45,71,0.4);cursor:pointer;">
      <div style="font-size:14px;font-weight:600;">${m.name}</div>
      <div style="font-size:11px;color:var(--muted);font-family:var(--mono);">${m.stock} ${m.unit} in stock</div>
    </div>`).join('');
