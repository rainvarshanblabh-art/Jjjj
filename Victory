async function sendChat(){
  const input=document.getElementById('chatInput');
  const msg=input.value.trim();
  if(!msg) return;
  input.value='';
  addChatBubble(msg,'user');
  addChatBubble('Thinking...','bot','...');
  const context=buildContext();
  try{
    const resp=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:1000,
        system:`You are FISO Pumps' internal AI assistant for a pump manufacturing company in Coimbatore, India. Answer questions about inventory, production, payments, and operations. Be concise and helpful. Current inventory context: ${context}`,
        messages:[{role:'user',content:msg}]
      })
    });
    const data=await resp.json();
    const reply=data.content?.map(c=>c.text||'').join('')||'Sorry, could not get a response.';
    removeLast();
    addChatBubble(reply,'bot');
  }catch(e){
    removeLast();
    addChatBubble('Connection error. Check your internet and try again.','bot');
  }
}

function buildContext(){
  const low=materials.filter(m=>m.stock<m.minStock).map(m=>`${m.name}:${m.stock}/${m.minStock}`).join(',');
  const totalOwe=payables.filter(p=>!p.paid).reduce((s,p)=>s+p.amount,0);
  const totalOwed=receivables.filter(r=>!r.paid).reduce((s,r)=>s+r.amount,0);
  return JSON.stringify({
    totalSKUs:materials.length,
    lowStock:low,
    pumps:pumps.map(p=>p.name),
    totalPayable:totalOwe,
    totalReceivable:totalOwed,
    recentActivity:activity.slice(0,5).map(a=>a.name)
  });
}

function addChatBubble(text,side,id){
  const msgs=document.getElementById('chatMessages');
  const div=document.createElement('div');
  div.className=`chat-bubble ${side}`;
  if(id) div.id='bubble_'+id;
  div.innerHTML=`<div class="bubble-text">${text}</div>`;
  msgs.appendChild(div);
  msgs.scrollTop=msgs.scrollHeight;
}
function removeLast(){
  const msgs=document.getElementById('chatMessages');
  const last=msgs.querySelector('#bubble_...');
  if(last) msgs.removeChild(last);
}
document.getElementById('chatInput').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendChat();}});

