function renderPayments(){
  const totalOwe=payables.filter(p=>!p.paid).reduce((s,p)=>s+p.amount,0);
  const totalOwe2=receivables.filter(r=>!r.paid).reduce((s,r)=>s+r.amount,0);
  const net=totalOwe2-totalOwe;
  document.getElementById('paySummary').innerHTML=`
    <div class="pay-sum-item"><div class="pay-sum-label">We Owe</div><div class="pay-sum-val" style="color:var(--danger);">₹${(totalOwe/1000).toFixed(1)}K</div></div>
    <div class="pay-sum-item"><div class="pay-sum-label">Owed To Us</div><div class="pay-sum-val" style="color:var(--success);">₹${(totalOwe2/1000).toFixed(1)}K</div></div>
    <div class="pay-sum-item"><div class="pay-sum-label">Net Position</div><div class="pay-sum-val" style="color:${net>=0?'var(--success)':'var(--danger)'};">₹${(net/1000).toFixed(1)}K</div></div>`;
  const today=new Date();
  document.getElementById('supplierPayables').innerHTML=payables.map(p=>{
    const due=new Date(p.dueDate);
    const diff=Math.round((today-due)/(1000*60*60*24));
    return `<div class="pay-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <div><div class="pay-name">${p.name}</div><div class="pay-detail">${p.detail}</div></div>
        <span class="badge ${p.paid?'b-ok':diff>0?'b-crit':'b-blue'}">${p.paid?'PAID':diff>0?`${diff}d OVERDUE`:'PENDING'}</span>
      </div>
      <div class="pay-amount" style="color:${p.paid?'var(--success)':'var(--danger)'};">₹${p.amount.toLocaleString()}</div>
      ${!p.paid?`<button class="btn-sm btn-add" onclick="markPaid('payable','${p.id}')">✓ Mark Paid</button>`:''}
    </div>`;
  }).join('');
  document.getElementById('distributorReceivables').innerHTML=receivables.map(r=>{
    const due=new Date(r.dueDate);
    const diff=Math.round((today-due)/(1000*60*60*24));
    return `<div class="pay-card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;">
        <div><div class="pay-name">${r.name}</div><div class="pay-detail">${r.detail}</div></div>
        <span class="badge ${r.paid?'b-ok':diff>0?'b-crit':'b-blue'}">${r.paid?'RECEIVED':diff>0?`${diff}d OVERDUE`:'PENDING'}</span>
      </div>
      <div class="pay-amount" style="color:${r.paid?'var(--success)':'var(--warn)'};">₹${r.amount.toLocaleString()}</div>
      ${!r.paid?`<button class="btn-sm btn-add" onclick="markPaid('receivable','${r.id}')">✓ Mark Received</button>`:''}
    </div>`;
  }).join('');
}

function markPaid(type,id){
  if(type==='payable'){const p=payables.find(x=>x.id===id);if(p)p.paid=true;}
  else{const r=receivables.find(x=>x.id===id);if(r)r.paid=true;}
  save();renderPayments();showToast('✓ Marked as paid','ok');
}

