  };
  if(existingId){const idx=pumps.findIndex(p=>p.id===existingId);pumps[idx]=data;}
  else pumps.push(data);
  save();closeModal();renderBOM();renderOrders();
  showToast(`✓ ${name} saved`,'ok');
}

