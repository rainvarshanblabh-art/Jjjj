.order-name{font-size:15px;font-weight:700;}
.order-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px;}
.os-item{background:var(--surface2);border-radius:8px;padding:10px;}
.os-label{font-size:9px;color:var(--muted);font-family:var(--mono);text-transform:uppercase;letter-spacing:1px;margin-bottom:3px;}
.os-val{font-size:14px;font-weight:700;}
.mat-check{background:var(--surface2);border-radius:10px;padding:12px;}
.mat-check-title{font-size:10px;font-family:var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;}
.mat-row{display:flex;justify-content:space-between;align-items:center;font-size:12px;padding:5px 0;border-bottom:1px solid rgba(28,45,71,0.3);}
.mat-row:last-child{border-bottom:none;}
.mat-ok{color:var(--success);font-family:var(--mono);font-size:11px;}
.mat-short{color:var(--danger);font-family:var(--mono);font-size:11px;}
