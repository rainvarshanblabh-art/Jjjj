function renderStock(){
  const q=(document.getElementById('stockSearch')?.value||'').toLowerCase();
  document.getElementById('stockSub').textContent=`FISO Pumps · ${materials.length} SKUs · ${categories.length} categories`;
  const canEdit=currentUser.role==='admin'||currentUser.role==='x'||currentUser.role==='staff';
  const showPrice=currentUser.role==='admin'||currentUser.role==='x';
  let html='';
  const usedCats = q
    ? ['Search Results']
    : [...new Set([...categories,...materials.map(m=>m.cat)])].filter(c=>materials.some(m=>m.cat===c));
  usedCats.forEach(cat=>{
    let list = q
      ? materials.filter(m=>m.name.toLowerCase().includes(q)||m.cat.toLowerCase().includes(q)||(m.brands&&m.brands.some(b=>b.toLowerCase().includes(q))))
      : materials.filter(m=>m.cat===cat);
    if(!list.length) return;
    html+=`<div class="cat-section">
      <div class="cat-header" onclick="toggleCat('cat_${cat.replace(/\s/g,'_')}')">
        <div><div class="cat-name">${cat}</div><div class="cat-count">${list.length} items</div></div>
        <span class="cat-arrow" id="arr_cat_${cat.replace(/\s/g,'_')}">▼</span>
      </div>
      <div class="cat-body ${q?'open':''}" id="cat_${cat.replace(/\s/g,'_')}">
        ${list.map(m=>{
          const s=stockStatus(m);
          return `<div class="part-row">
            <div style="flex:1;min-width:0;">
              <div class="part-name">${m.name}</div>
              <div class="part-meta">${(m.brands||[]).join(' · ')}</div>
              <div class="stock-bar"><div class="stock-fill ${s.cls}" style="width:${s.pct}%"></div></div>
              <span class="badge ${s.badge}">${s.label}</span>
            </div>
            <div class="part-right" style="min-width:90px;">
              <div class="part-stock-num ${s.cls==='sf-crit'?'sv-red':s.cls==='sf-low'?'sv-warn':'sv-green'}">${m.stock}</div>
              <div class="part-meta">${m.unit}</div>
              ${showPrice?`<div class="part-meta" style="color:var(--accent);">₹${m.price}</div>`:''}
              <div class="part-actions">
                <button class="btn-sm btn-add" onclick="openPartDetail('${m.id}')">Info</button>
                ${canEdit?`<button class="btn-sm btn-edit" onclick="editMaterial('${m.id}')">Edit</button>`:''}
                ${currentUser.role==='admin'||currentUser.role==='x'?`<button class="btn-sm btn-del" onclick="deleteMaterial('${m.id}')">Del</button>`:''}
              </div>
            </div>
          </div>`;
        }).join('')}
        ${currentUser.role==='admin'||currentUser.role==='x'?`<div style="padding:12px 16px;"><button class="btn-sm btn-add" onclick="openAddMaterial('${cat}')">＋ Add to ${cat}</button></div>`:''}
      </div>
    </div>`;
  });
  if(currentUser.role==='admin'||currentUser.role==='x'){
    html+=`<button class="btn-confirm" onclick="openAddMaterial('')" style="margin-top:4px;">＋ Add New Material</button>`;
  }
  document.getElementById('stockCategories').innerHTML=html||'<div style="text-align:center;color:var(--muted);padding:30px;font-family:var(--mono);font-size:13px;">No results found</div>';
}

function toggleCat(id){
  const body=document.getElementById(id);
  const arr=document.getElementById('arr_'+id);
  if(!body) return;
  body.classList.toggle('open');
  if(arr) arr.classList.toggle('open');
}

function stockStatus(m){
  if(m.stock===0) return{cls:'sf-crit',badge:'b-crit',label:'CRITICAL',pct:0};
  if(m.stock<m.minStock) return{cls:'sf-low',badge:'b-low',label:'LOW',pct:Math.round(m.stock/m.minStock*100)};
  return{cls:'sf-ok',badge:'b-ok',label:'OK',pct:Math.min(100,Math.round(m.stock/(m.minStock*2)*100))};
}

