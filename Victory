function confirmAddMaterial(){
  const name=document.getElementById('mName').value.trim();
  if(!name){showToast('Enter a part name','err');return;}
  const brands=document.getElementById('mBrands').value.split(',').map(b=>b.trim()).filter(Boolean);
  const m={
    id:'m'+Date.now(),name,
    cat:document.getElementById('mCat').value||'General',
    brands:brands.length?brands:['General'],
    price:parseFloat(document.getElementById('mPrice').value)||0,
    unit:document.getElementById('mUnit').value||'pcs',
    stock:parseInt(document.getElementById('mStock').value)||0,
    minStock:parseInt(document.getElementById('mMin').value)||10
  };
  materials.push(m);
  logActivity(`${m.name} added to inventory`,`${currentUser.name}`,`+${m.stock}`,'plus');
  save();closeModal();renderStock();renderDashboard();
  showToast('✓ '+m.name+' added','ok');
}

function confirmQuickAdd(id){
