  const u=users.find(x=>x.id===id);
  u.name=document.getElementById('guName').value||u.name;
  u.username=document.getElementById('guUser').value||u.username;
  u.password=document.getElementById('guPass').value||u.password;
  u.role=document.getElementById('guRole').value;
  save();closeModal();renderGodMode();showToast('✓ User updated','ok');
}

function godDeleteUser(id){
  openModal(`
    <div class="modal-title">Delete User?</div>
    <div class="modal-sub">They will lose access immediately</div>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-danger-btn" onclick="confirmGodDeleteUser('${id}')">Delete</button>
    </div>`);
}
function confirmGodDeleteUser(id){
  users=users.filter(x=>x.id!==id);
  save();closeModal();renderGodMode();showToast('User deleted','warn');
}

function openAddUser(){
  openModal(`
    <div class="modal-title">Add New User</div>
    <div class="modal-sub">FISO Pumps</div>
    <div class="field-label">Display Name</div>
    <input class="field" id="nuName" placeholder="e.g. Ravi Kumar" autocorrect="off" />
    <div class="field-label">Username</div>
    <input class="field" id="nuUser" placeholder="e.g. ravi.kumar" autocorrect="off" autocapitalize="none" />
    <div class="field-label">Password</div>
    <input class="field" id="nuPass" placeholder="min 6 characters" />
    <div class="field-label">Role</div>
    <select class="field" id="nuRole">
      <option value="staff">Store Staff</option>
      <option value="manager">Manager</option>
      <option value="admin">Admin</option>
    </select>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-confirm" onclick="confirmAddUser()">Add User</button>
    </div>`);
}

function confirmAddUser(){
  const name=document.getElementById('nuName').value.trim();
  const username=document.getElementById('nuUser').value.trim();
  const password=document.getElementById('nuPass').value;
  if(!name||!username||!password){showToast('Fill all fields','err');return;}
  if(users.find(u=>u.username===username)){showToast('Username taken','err');return;}
  users.push({id:'u'+Date.now(),username,password,role:document.getElementById('nuRole').value,name});
  save();closeModal();renderGodMode();showToast('✓ User added','ok');
}

function openAddCategory(){
  openModal(`
    <div class="modal-title">Add Category</div>
    <input class="field" id="newCat" placeholder="e.g. Filters" autocorrect="off" style="margin-top:10px;" />
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-confirm" onclick="confirmAddCategory()">Add</button>
    </div>`);
}
function confirmAddCategory(){
  const c=document.getElementById('newCat').value.trim();
  if(!c){showToast('Enter category name','err');return;}
  categories.push(c);save();closeModal();renderGodMode();showToast('✓ Category added','ok');
}
function deleteCategory(i){
  categories.splice(i,1);save();renderGodMode();showToast('Category removed','warn');
}

function setAccent(color){
  document.documentElement.style.setProperty('--accent',color);
  showToast('Color updated','ok');
}

function applyGodSettings(){
  const name=document.getElementById('godAppName').value;
  if(name){
    document.querySelectorAll('.logo-main').forEach(el=>{el.innerHTML=name+' <span style="color:var(--accent)">ERP</span>';});
  }
  showToast('✓ Settings applied','ok');
}

function exportAllData(){
  const data={materials,pumps,orders,payables,receivables,activity,users:users.map(u=>({...u,password:'[hidden]'}))};
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;a.download='fiso_pumps_data.json';a.click();
  URL.revokeObjectURL(url);
  showToast('✓ Data exported','ok');
}

function confirmReset(){
  openModal(`
    <div class="modal-title">Reset All Data?</div>
    <div class="modal-sub">This will delete everything and cannot be undone</div>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-danger-btn" onclick="doReset()">Reset Everything</button>
    </div>`);
}
function doReset(){
  localStorage.clear();
  closeModal();
  location.reload();
}

// ═══════════════════════════════════════════════
// MODAL & TOAST
// ═══════════════════════════════════════════════
function openModal(html){
  document.getElementById('modalBox').innerHTML=html;
  document.getElementById('modalOverlay').classList.remove('hidden');
}
function closeModal(){
  document.getElementById('modalOverlay').classList.add('hidden');
}
document.getElementById('modalOverlay').addEventListener('click',function(e){
  if(e.target===this) closeModal();
});

let toastTimer;
function showToast(msg,type='ok'){
  const t=document.getElementById('toast');
  t.textContent=msg;
  t.className=`toast t-${type} show`;
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),2500);
}
</script>
