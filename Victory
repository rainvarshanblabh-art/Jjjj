const NAV_CONFIG = {
  dashboard:{icon:'◈',label:'Home',roles:['staff','manager','admin','x']},
  stock:{icon:'⬡',label:'Stock',roles:['staff','manager','admin','x']},
  movement:{icon:'＋',label:'Move',roles:['staff','admin','x']},
  production:{icon:'◻',label:'Orders',roles:['manager','admin','x']},
  bom:{icon:'▦',label:'BOM',roles:['admin','x']},
  payments:{icon:'₹',label:'Pay',roles:['admin','x']},
  chat:{icon:'💬',label:'AI',roles:['manager','admin','x']},
  profile:{icon:'👤',label:'Me',roles:['staff','manager','admin','x']},
  god:{icon:'⚡',label:'God',roles:['x']},
};

function buildNav(){
  const role = currentUser.role;
  const nav = document.getElementById('bottomNav');
  nav.innerHTML='';
  Object.entries(NAV_CONFIG).forEach(([key,cfg])=>{
    if(!cfg.roles.includes(role)) return;
    // check permissions
    if(role!=='x'&&role!=='admin'&&permissions[role]&&permissions[role][key]===false) return;
    const el = document.createElement('div');
    el.className='bnav-item'+(key==='dashboard'?' active':'');
    el.id='nav-'+key;
    el.innerHTML=`<div class="bnav-icon">${cfg.icon}</div>${cfg.label}`;
    el.onclick=()=>switchPage(key);
    nav.appendChild(el);
  });
}

function switchPage(name){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.bnav-item').forEach(n=>n.classList.remove('active'));
  const pg = document.getElementById('page-'+name);
  const nv = document.getElementById('nav-'+name);
  if(pg) pg.classList.add('active');
  if(nv) nv.classList.add('active');
  document.getElementById('mainContent').scrollTop=0;
  if(name==='stock') renderStock();
  if(name==='bom') renderBOM();
  if(name==='payments') renderPayments();
  if(name==='production'){renderOrders();populateCapSelect();}
  if(name==='god') renderGodMode();
  if(name==='profile') renderProfile();
  if(name==='movement') renderMovement();
}

