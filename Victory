function renderDashboard(){
  const total=materials.length;
  const low=materials.filter(m=>m.stock>0&&m.stock<m.minStock).length;
  const crit=materials.filter(m=>m.stock===0).length;
  const totalStock=materials.reduce((a,m)=>a+m.stock,0);
  document.getElementById('dashStats').innerHTML=`
    <div class="stat-card sc-blue"><div class="stat-label">Materials</div><div class="stat-val sv-blue">${total}</div><div class="stat-hint">SKUs tracked</div></div>
    <div class="stat-card sc-green"><div class="stat-label">Total Stock</div><div class="stat-val sv-green">${totalStock}</div><div class="stat-hint">units in store</div></div>
    <div class="stat-card sc-warn"><div class="stat-label">Low Stock</div><div class="stat-val sv-warn">${low}</div><div class="stat-hint">need ordering</div></div>
    <div class="stat-card sc-red"><div class="stat-label">Critical</div><div class="stat-val sv-red">${crit}</div><div class="stat-hint">out of stock</div></div>`;
  const alerts=materials.filter(m=>m.stock<m.minStock).sort((a,b)=>a.stock-b.stock).slice(0,4);
  document.getElementById('dashAlerts').innerHTML=alerts.map(m=>{
    const ic=m.stock===0;
    return `<div class="alert ${ic?'alert-red':'alert-warn'}"><span style="font-size:16px;">${ic?'🔴':'⚠️'}</span><span><strong>${ic?'Critical':'Low Stock'}:</strong> ${m.name} — ${m.stock===0?'OUT OF STOCK':`only ${m.stock} left (min: ${m.minStock})`}</span></div>`;
  }).join('');
  document.getElementById('activityFeed').innerHTML=activity.slice(0,6).map(a=>`
    <div class="act-row">
      <div><div class="act-name">${a.name}</div><div class="act-meta">${a.detail} · ${a.time}</div></div>
      <div class="act-qty ${a.type==='plus'?'act-plus':'act-minus'}">${a.qty}</div>
    </div>`).join('');
}

