        <button class="remove-mat-btn" onclick="removeBomRow(${i})">✕</button>
      </div>`).join('');
  }
  window.removeBomRow=(i)=>{
    saveBomRows();
    if(window._bomMats.length<=1) return;
    window._bomMats.splice(i,1);
    document.getElementById('bomMatArea').innerHTML=renderRows();
  };
  window.addBomRow=()=>{
    saveBomRows();
    window._bomMats.push({matId:'',qty:1});
    document.getElementById('bomMatArea').innerHTML=renderRows();
  };
  window.saveBomRows=()=>{
    window._bomMats=window._bomMats.map((_,i)=>({
      matId:document.getElementById('bm_m_'+i)?.value||'',
      qty:parseInt(document.getElementById('bm_q_'+i)?.value)||1
    }));
  };
  openModal(`
    <div class="modal-title">${isEdit?'Edit Pump Model':'New Pump Model'}</div>
    <div class="modal-sub">BOM Configuration</div>
    <div class="field-label">Pump Name</div>
    <input class="field" id="pName" value="${pump?.name||''}" placeholder="e.g. Big Flow 2HP" autocorrect="off" />
    <div class="field-row" style="margin-bottom:10px;">
      <div style="flex:0 0 80px;"><div class="field-label">Icon</div><input class="field" id="pIcon" value="${pump?.icon||'⚙️'}" /></div>
      <div style="flex:1;"><div class="field-label">Selling Price ₹</div><input class="field" id="pSell" type="number" inputmode="numeric" value="${pump?.sellPrice||''}" /></div>
    </div>
    <div class="sec-label">Bill of Materials</div>
    <div id="bomMatArea">${renderRows()}</div>
    <button class="add-mat-line" onclick="addBomRow()">＋ Add Material</button>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="closeModal()">Cancel</button>
      <button class="modal-confirm" onclick="confirmPump('${pump?.id||''}')">Save</button>
    </div>`);
}

function confirmPump(existingId){
  window.saveBomRows&&window.saveBomRows();
  const name=document.getElementById('pName').value.trim();
  if(!name){showToast('Enter pump name','err');return;}
  const mats=window._bomMats.filter(bm=>bm.matId);
  if(!mats.length){showToast('Add at least one material','err');return;}
  const data={
    id:existingId||'p'+Date.now(),
    name,icon:document.getElementById('pIcon').value||'⚙️',
    sellPrice:parseFloat(document.getElementById('pSell').value)||0,
