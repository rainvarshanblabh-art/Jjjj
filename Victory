  const m=materials.find(x=>x.id===id);
  m.stock+=qty;
  const note=document.getElementById('qaNote').value||'';
  logActivity(`${m.name} stock added`,`${currentUser.name} · ${note||'Quick add'}`,`+${qty}`,'plus');
  save();closeModal();renderStock();renderDashboard();
  showToast(`+${qty} added to ${m.name}`,'ok');
}

