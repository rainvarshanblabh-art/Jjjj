function calcCapacity(){
  const pumpId=document.getElementById('capPumpSelect').value;
  const reserved=parseInt(document.getElementById('capReserved').value)||0;
  if(!pumpId){showToast('Select a pump model','err');return;}
  const pump=pumps.find(p=>p.id===pumpId);
  const result=document.getElementById('capResult');
  // calc available stock after reserving for planned orders
  const matRows=pump.materials.map(bm=>{
    const mat=materials.find(m=>m.id===bm.matId);
    if(!mat) return null;
    const reservedQty=bm.qty*reserved;
    const available=Math.max(0,mat.stock-reservedQty);
    const canMake=bm.qty>0?Math.floor(available/bm.qty):999;
    return{mat,bm,reservedQty,available,canMake};
  }).filter(Boolean);
  const maxMake=Math.min(...matRows.map(r=>r.canMake));
  const bottleneck=matRows.find(r=>r.canMake===maxMake&&maxMake<999);
  result.innerHTML=`
    <div class="cap-result">
      <div class="cap-pump-name">${pump.icon} ${pump.name}</div>
      <div class="cap-can-make">${maxMake}</div>
      <div class="cap-units">units you can make right now</div>
      ${reserved?`<div style="font-size:12px;color:var(--muted);font-family:var(--mono);margin-bottom:10px;">(After reserving ${reserved} units for planned orders)</div>`:''}
      ${bottleneck?`<div class="cap-bottleneck">⚠️ <strong>Bottleneck:</strong> ${bottleneck.mat.name} — only ${bottleneck.available} available after reservation</div>`:''}
      <div class="mat-check">
        <div class="mat-check-title">Material Breakdown</div>
        ${matRows.map(r=>`<div class="mat-row">
          <span>${r.mat.name}</span>
          <span>${r.canMake===0?`<span style="color:var(--danger);font-family:var(--mono);font-size:11px;">Can make 0</span>`:`<span style="color:var(--success);font-family:var(--mono);font-size:11px;">Can make ${r.canMake}</span>`}</span>
        </div>`).join('')}
      </div>
    </div>`;
}

function renderOrders(){
